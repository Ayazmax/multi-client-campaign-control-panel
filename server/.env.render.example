# Render Web Service + Render PostgreSQL.
# Use the Internal Database URL from the Render Postgres instance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Render sets PORT. 10000 is the usual platform default.
PORT=10000
# Comma-separated. Set this to the Vercel site URL after the frontend is deployed.
CLIENT_ORIGIN=https://your-app.vercel.app
